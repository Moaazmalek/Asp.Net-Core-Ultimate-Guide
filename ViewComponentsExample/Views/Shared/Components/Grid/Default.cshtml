@model PersonGridModel
<div class="box">
    @* <h3>@((PersonGridModel)ViewData["Grid"]).GridTitle</h3> *@
    <h3>@Model.GridTitle</h3>
    <table class="table w-100" >
            <thead> 
                <tr> 
                    <th>Sl. No</th>
                    <th>Name</th>
                </tr>
            </thead>
    <tbody>
            @foreach (Person person in Model.Persons)
            {
                <tr>
                    <td>@person.Name</td>
                    <td>@person.JobTitle</td>
                </tr>
            }
            
        
    </tbody>
    </table>
</div>